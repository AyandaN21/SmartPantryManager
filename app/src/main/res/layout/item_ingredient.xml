<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="#FFFFFF"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/tvIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Name"
        android:textColor="#163D32"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Quantity and Unit -->
    <TextView
        android:id="@+id/tvIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Quantity"
        android:textColor="#4F4B47"
        android:textSize="15sp" />

    <!-- Expiry Date -->
    <TextView
        android:id="@+id/tvIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Expiry date"
        android:textColor="#8A6A45"
        android:textSize="14sp" />

    <!-- Edit and Delete Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#174C3C"
            android:text="EDIT"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#B7473A"
            android:text="DELETE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>