<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F3ED"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvIngredientFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Add Ingredient"
            android:textColor="#163D32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Enter your ingredient details"
            android:textColor="#77716B"
            android:textSize="14sp" />

        <!-- Ingredient Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Ingredient Name"
            android:textColor="#163D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#174C3C"
            android:hint="e.g. Eggs"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#8A8A8A" />

        <!-- Quantity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quantity"
            android:textColor="#163D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#174C3C"
            android:hint="e.g. 8"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#8A8A8A" />

        <!-- Unit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Unit"
            android:textColor="#163D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtUnit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#174C3C"
            android:hint="e.g. pieces, kg, litre"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#8A8A8A" />

        <!-- Expiry -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Expiry Date (Optional)"
            android:textColor="#163D32"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:text="No expiry date selected"
            android:textColor="#77716B"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnChooseDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D8C6AD"
            android:text="CHOOSE DATE"
            android:textColor="#163D32"
            android:textStyle="bold" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#174C3C"
            android:text="SAVE INGREDIENT"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#B66A2C"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>